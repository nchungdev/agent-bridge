# copy to .env
AGENT_BRIDGE_TOKEN=change-me-openssl-rand-hex-24
WORKSPACE_DIR=./workspace
TZ=Asia/Ho_Chi_Minh

# Zalo bot (optional) - chat with an agent from Zalo. Needs a public HTTPS URL for /api/zalo/webhook.
# ZALO_BOT_TOKEN=            # from the "Zalo Bot Manager" OA; never commit it
# ZALO_WEBHOOK_SECRET=       # 8-256 chars; the same value you pass to setWebhook as secret_token
# ZALO_ALLOWED_IDS=          # comma separated Zalo user ids allowed to drive agents (empty = integration off)
# ZALO_ENGINE=claude         # engine used for Zalo chats
# ZALO_MODE=plan             # permission mode; plan = read-only
# ZALO_WORKSPACE=            # working folder (default: your home)
